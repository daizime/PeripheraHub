#include <winver.h>

1 ICON "PeripheralHub.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Peripheral Hub Initial Preview\0"
            VALUE "FileVersion", "@PERIPHERAL_APP_VERSION@\0"
            VALUE "InternalName", "PeripheralHub\0"
            VALUE "OriginalFilename", "PeripheralHub.exe\0"
            VALUE "ProductName", "Peripheral Hub Initial Preview\0"
            VALUE "ProductVersion", "@PERIPHERAL_APP_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
